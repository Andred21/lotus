# Molde do .env de PRODUÇÃO. Este arquivo é versionado e NÃO carrega valor
# sensível: o arquivo real vive só no servidor, em /opt/lotus/.env, com
# chmod 600 (spec D6). Chave vazia aqui é intencional — o entrypoint recusa
# subir sem as obrigatórias, então falta de valor vira falha imediata e não
# comportamento estranho meia hora depois.
#
# Chaves de backend/.env.example que NÃO entram aqui, e por quê (medido
# contra config/*.php, não suposto):
#   APP_TIMEZONE     — config/app.php linha 75 fixa 'timezone' => 'UTC' como
#                       literal, não lê env('APP_TIMEZONE'). Chave morta.
#   APP_FAKER_LOCALE — só consumida pelo Faker de factories/seeders, nunca em
#                       runtime de request.
#   LOG_STACK        — só importa quando LOG_CHANNEL=stack; aqui é stderr.
#   MEMCACHED_HOST   — cache é `database` (ver comentário abaixo); memcached
#                       nunca é o driver escolhido.
#   REDIS_*          — session/cache/queue são todos `database`; não existe
#                       serviço Redis nem em produção nem no compose de dev.
#   AWS_ENDPOINT, AWS_ENDPOINT_PUBLIC, AWS_USE_PATH_STYLE_ENDPOINT
#                     — mecanismo de MinIO (config/filesystems.php): endpoint
#                       alternativo e path-style só existem para o S3 fake de
#                       dev. S3 real não usa nenhum dos três.
#   VITE_APP_NAME     — sem uso em frontend/ (grep não encontra consumidor);
#                       chave morta herdada do template do Vite.
APP_NAME=Lotus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# Locale de fato lido por config/app.php (APP_TIMEZONE não é — ver acima).
APP_LOCALE=es_CL
APP_FALLBACK_LOCALE=en

# "file" é suficiente: instância única, sem necessidade de coordenar
# maintenance mode entre múltiplas máquinas (driver "cache" é para isso).
APP_MAINTENANCE_DRIVER=file

# Custo do bcrypt para hash de senha de admin/redator — não é segredo, é
# parâmetro de custo, igual em qualquer ambiente.
BCRYPT_ROUNDS=12

# stderr e não `stack`: em produção quem coleta é o Docker, e log em arquivo
# exigiria volume só para não se perder.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
# Canal de deprecations do framework, independente de LOG_CHANNEL. `null`
# descarta o aviso — mesmo default do config, explícito aqui.
LOG_DEPRECATIONS_CHANNEL=null

# RDS — nunca um container (ADR-09).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Os três em `database` é medição do repositório, não default herdado: é o que
# dispensa volume de sessão, volume de cache e worker de fila.
SESSION_DRIVER=database
SESSION_DOMAIN=
# Config de cookie de sessão (central para Sanctum SPA — lei #4): valores
# fixos do projeto, não variam por deploy.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# Sem infra de broadcast (nenhum canal WebSocket no projeto); "log" é o
# default seguro que não exige serviço nenhum.
BROADCAST_CONNECTION=log

# Origem única (spec D2): SPA e API no mesmo host. FRONTEND_URL e
# SANCTUM_STATEFUL_DOMAINS descrevem esse host único.
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=

# Identidade jurídica da OTEC que emite os certificados (peso legal — CLAUDE.md
# §1). Não é segredo: é dado público que vai impresso no documento, igual em
# qualquer ambiente — por isso tem valor e não fica vazio.
CERTIFICATE_ISSUER_NAME="OTEC LOTUS SpA"
CERTIFICATE_ISSUER_RUT=77.510.327-2

# S3 real: sem AWS_ENDPOINT (aquilo é MinIO de dev) e sem path-style.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=

# Nome do serviço no compose de produção (ADR-12) — igual em qualquer deploy
# que use este mesmo docker-compose.prod.yml, por isso não fica vazio.
GOTENBERG_URL=http://gotenberg:3000

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
# Vazio como MAIL_HOST: depende do relay SMTP real escolhido no deploy
# (config/mail.php lê env('MAIL_SCHEME') sem default — null deixa o Symfony
# Mailer inferir a partir da porta).
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Lotus
