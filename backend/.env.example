APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Em desenvolvimento, o `environment:` do docker-compose.yml SOBRESCREVE
# APP_URL (e as quatro outras chaves de URL abaixo — SANCTUM_STATEFUL_DOMAINS,
# FRONTEND_URL, AWS_ENDPOINT_PUBLIC, AWS_URL) com valores derivados do offset
# de porta da árvore de trabalho (`.env` da raiz) — editar aqui não tem
# efeito. Ver ADR-13.
APP_URL=http://localhost:8080


APP_TIMEZONE=America/Santiago
APP_LOCALE=es_CL
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
DB_DATABASE=lotus
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax

# Sobrescrita em dev pelo compose (ver comentário de APP_URL acima). Ver ADR-13.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080
FRONTEND_URL=http://localhost:5173

# Identidade jurídica da OTEC que emite os certificados. Congela no snapshot no
# ato da emissão: mudar aqui não reescreve documento já emitido.
CERTIFICATE_ISSUER_NAME="OTEC LOTUS SpA"
CERTIFICATE_ISSUER_RUT=77.510.327-2

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@lotus.cl"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=lotus
AWS_SECRET_ACCESS_KEY=lotus-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=lotus
AWS_ENDPOINT=http://minio:9000
# AWS_ENDPOINT_PUBLIC e AWS_URL: sobrescritas em dev pelo compose (ver
# comentário de APP_URL acima). Ver ADR-13.
AWS_ENDPOINT_PUBLIC=http://localhost:9000
AWS_URL=http://localhost:9000/lotus
AWS_USE_PATH_STYLE_ENDPOINT=true

GOTENBERG_URL=http://gotenberg:3000

VITE_APP_NAME="${APP_NAME}"
