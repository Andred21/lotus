# syntax=docker/dockerfile:1

# ── imagens base ──────────────────────────────────────────────────────────────
# Todo FROM abaixo é fixado por digest, e a tag fica ao lado só para se ler que
# versão é aquela. A razão é o objetivo do item 11: "artefato imutável
# identificável pelo SHA". Com tag móvel, reconstruir o MESMO commit meses
# depois puxa uma base atualizada e produz um digest diferente sob a mesma tag
# de SHA — a imutabilidade valeria só enquanto ninguém reconstruísse.
#
# Digests capturados em 2026-08-25. Para atualizar uma base, resolva o digest
# novo e troque a linha (nunca edite o digest à mão):
#
#   docker buildx imagetools inspect <imagem:tag> --format '{{.Manifest.Digest}}'
#
# O que isto NÃO fixa: os índices de pacote do apk e do Alpine, que o estágio
# `app` consulta em tempo de build. Por isso o job `image` do CI se recusa a
# reescrever uma tag de SHA que já existe, em vez de prometer build reprodutível
# bit a bit — promessa que este Dockerfile não teria como cumprir sozinho.

# ── vendor ────────────────────────────────────────────────────────────────────
# --platform=$BUILDPLATFORM: este estágio produz PHP puro, byte a byte igual em
# qualquer arquitetura, então emulá-lo para arm64 paga QEMU para gerar o mesmo
# resultado. O `app` continua por arquitetura — lá o docker-php-ext-install
# compila extensão nativa e a emulação é inevitável.
FROM --platform=$BUILDPLATFORM composer:2@sha256:4d71c3c2109c61d5415544264b59ad4087e4c5b7244481723664138fd36d5040 AS vendor
WORKDIR /app
COPY backend/composer.json backend/composer.lock ./
# --ignore-platform-reqs (desvio do brief): o estágio `vendor` roda no image
# base `composer:2`, que não tem ext-gd — só o estágio `app` a instala via
# docker-php-ext-install. Como --no-scripts já impede execução de código de
# extensão aqui, ignorar o platform-check é seguro: só resolve e baixa pacotes.
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --no-interaction --ignore-platform-reqs
COPY backend/ ./
# SEM --no-scripts de propósito: o post-autoload-dump do composer.json roda
# `php artisan package:discover`, que reescreve bootstrap/cache/packages.php.
# O COPY acima trouxe esse arquivo do host com providers só-de-dev
# (laravel/pail, nunomaduro/collision, laravel-lang/*), e o PackageManifest do
# Laravel não regenera um manifesto que já existe. Sem rodar o discover aqui,
# a imagem de produção sobe com esses providers e quebra em class-not-found.
RUN composer dump-autoload --optimize --classmap-authoritative --no-dev

# ── spa ───────────────────────────────────────────────────────────────────────
# --platform=$BUILDPLATFORM pelo mesmo motivo do `vendor`, e aqui ele não é só
# economia: MEDIDO em 2026-09-04, no espelho de ccaacacf (run 33907874327 da
# Gatika-CL), o `pnpm install` emulado para arm64 morreu em
#   qemu: uncaught target signal 4 (Illegal instruction) - core dumped
# aos 26,5 s e o passo PENDUROU — sem erro, sem timeout, 44 min até o cancelamento
# à mão. O mesmo estágio em amd64 fechou em ~1 min. O `dist/` é HTML/CSS/JS
# estático: construí-lo na plataforma do construtor dá o mesmo artefato sem
# passar Node por emulador.
FROM --platform=$BUILDPLATFORM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS spa
WORKDIR /spa
# O package.json vem ANTES do corepack de propósito: `corepack prepare
# --activate` resolve a versão pelo campo `packageManager`, então o arquivo
# precisa existir para ele ler. Antes de 2026-08-24 esta linha fixava
# pnpm@11.22.0 à mão porque o campo não existia; ele existe agora, e a versão
# tem um dono só.
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && corepack prepare --activate
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
# VAZIO de propósito (spec D2): com origem única o axios usa caminho relativo,
# e é isso que mantém a imagem agnóstica de ambiente.
ENV VITE_API_URL=""
RUN pnpm build

# ── app ───────────────────────────────────────────────────────────────────────
FROM php:8.3-fpm-alpine@sha256:bf90236449d333cef008b1f01c72a3d4f11a6470a74629665e4c6b6158f03fc8 AS app
# Decisão do João (2026-08-22): headers de compilação (-dev) só servem para o
# docker-php-ext-install rodar — mantê-los na camada final não beneficia o
# runtime, só infla a imagem e o tempo de `pull` a cada deploy. Por isso
# entram como pacote virtual e são removidos na mesma instrução RUN; se
# saíssem numa RUN separada, a camada anterior já teria gravado os arquivos e
# a remoção depois não economizaria nada. As libs de runtime (sem -dev) ficam
# fora do pacote virtual porque as extensões compiladas dependem delas em
# tempo de execução.
RUN apk add --no-cache --virtual .build-deps libzip-dev icu-dev oniguruma-dev libpng-dev \
 && apk add --no-cache libzip icu-libs libpng oniguruma \
 && docker-php-ext-install pdo_mysql gd zip intl bcmath opcache \
 && apk del .build-deps

COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini
COPY docker/php/memory-cli.ini /usr/local/etc/php/conf.d/zz-memory-cli.ini
COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/zz-opcache.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/zz-www.conf
COPY docker/php/entrypoint.sh /usr/local/bin/entrypoint

RUN addgroup -g 1000 appuser && adduser -D -u 1000 -G appuser appuser
WORKDIR /var/www
# Código COPIADO, nunca montado — é a metade "não depende do working tree do
# servidor" da DoD do item 10.
COPY --from=vendor --chown=appuser:appuser /app /var/www
RUN chmod +x /usr/local/bin/entrypoint \
 && chown -R appuser:appuser /var/www/storage /var/www/bootstrap/cache
USER appuser
ENTRYPOINT ["entrypoint"]
CMD ["php-fpm"]

# ── web ───────────────────────────────────────────────────────────────────────
FROM nginx:alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913 AS web
COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=spa /spa/dist /usr/share/nginx/html

# ── clamav ────────────────────────────────────────────────────────────────────
# Imagem PRÓPRIA do antivírus, e não `clamav/clamav`: medido em 2026-09-04, o
# repositório oficial publica só linux/amd64 (1.4, 1.4_base, latest e stable),
# e o host de produção é t4g/Graviton. O `docker compose pull` do deploy.sh
# morria em "no matching manifest for linux/arm64/v8 in the manifest list
# entries" — antes de subir qualquer container, então o defeito nunca chegou a
# ser um deploy pela metade.
#
# SEM --platform=$BUILDPLATFORM, ao contrário de `vendor` e `spa`: aqui o
# artefato É o binário nativo, que roda no host. `apk add` de pacote pronto sob
# emulação é I/O, não compilação — o preço é baixo.
#
# clamav 1.4.2-r0 no community do Alpine 3.21: mesma linha 1.4 contra a qual o
# protocolo INSTREAM do ClamAvScanner foi verificado em 2026-08-25.
FROM alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d AS clamav
RUN apk add --no-cache clamav clamav-daemon clamav-libunrar \
 && mkdir -p /var/lib/clamav /run/clamav \
 && chown -R clamav:clamav /var/lib/clamav /run/clamav
COPY docker/clamav/clamd.conf /etc/clamav/clamd.conf
COPY docker/clamav/freshclam.conf /etc/clamav/freshclam.conf
COPY docker/clamav/entrypoint.sh /usr/local/bin/entrypoint-clamav
RUN chmod +x /usr/local/bin/entrypoint-clamav
EXPOSE 3310
ENTRYPOINT ["entrypoint-clamav"]
