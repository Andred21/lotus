# Molde do /opt/lotus/.env de PRODUÇÃO (spec v2 do item 10). Copie para o
# host, preencha os <...> e proteja: chmod 600, dono root.
#
# ESTE é o arquivo que o runbook instala em /opt/lotus/.env, e ele tem de
# carregar as chaves de segurança por conta própria. O outro molde do
# repositório (backend/.env.production.example) não chega ao host — quando os
# dois divergiram em 20 chaves, foi ESTE que ficou sem elas (Q-2 do review de
# 2026-09-20). Chave que exista lá e importe em produção, entra aqui também.
APP_NAME=Lotus
APP_ENV=production
# Gere no host (herança da spec do runtime: key:generate exige --entrypoint php):
#   docker run --rm --entrypoint php ghcr.io/gatika-cl/lotus-app:<sha> artisan key:generate --show
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=http://app.lotusotec.cl
# FASE SEM DNS: enquanto o registro A não existir, o acesso é por IP e os quatro
# campos de host abaixo (APP_URL, SESSION_DOMAIN, FRONTEND_URL,
# SANCTUM_STATEFUL_DOMAINS) trocam o domínio pelo `http://<EIP>` / `<EIP>` —
# MENOS o SESSION_DOMAIN, que vai para o literal `null`. Não é detalhe, e as
# outras três saídas estão todas fechadas:
#   - deixar o DOMÍNIO: `session.domain` é `env('SESSION_DOMAIN')`, e um domínio
#     que o navegador não está visitando faz o cookie não voltar — login em
#     401/419 com a API saudável;
#   - pôr o EIP: `Domain=` com IP não faz domain-match (RFC 6265 §5.1.3, que
#     exige host name) e o navegador descarta o cookie;
#   - COMENTAR a linha: o gate do entrypoint (docker/php/entrypoint.sh) exige
#     SESSION_DOMAIN presente e não-vazia e o container sai 1 em
#     `entrypoint: variável obrigatória ausente: SESSION_DOMAIN` — o deploy
#     quebra no `up`, antes do healthcheck.
# `null` serve aos dois lados de uma vez: string não-vazia para o teste `-z` do
# shell, e `Illuminate\Support\Env` converte o literal `null` em PHP null
# (Env.php, `case 'null': return;`), então `session.domain` fica nulo e o cookie
# se prende ao host corrente — IP inclusive.
# Quando o registro A chegar, isto volta ao domínio junto com o TLS, e o passo
# está escrito no runbook §11 — não é de memória.

# es-CL é o locale do produto e o FALLBACK (ADR-15). Ausentes, `config/app.php`
# cai no default `'en'`: requisição sem `Accept-Language` — o QR público lido
# por scanner, notificação, job, artisan — responde em inglês a um cliente
# chileno. O middleware SetLocale só cobre quem manda o header.
APP_LOCALE=es_CL
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lotus
DB_USERNAME=root
DB_PASSWORD=<senha forte>
# Lidas pelo serviço mysql do compose (init do volume) e pelo healthcheck.
# MYSQL_ROOT_PASSWORD deve ser IGUAL a DB_PASSWORD; MYSQL_DATABASE igual a
# DB_DATABASE.
MYSQL_DATABASE=lotus
MYSQL_ROOT_PASSWORD=<a mesma senha forte>

SESSION_DRIVER=database
SESSION_DOMAIN=app.lotusotec.cl   # na fase sem DNS: o literal null (nunca comentada)
# Config do cookie de sessão — central para o Sanctum SPA (lei §5.4). Não são
# defaults reescritos por hábito: sem a chave no arquivo, o valor vale por
# coincidência com o default do framework, e coincidência não sobrevive a um
# upgrade.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
# FASE: `false` enquanto o acesso for por IP em HTTP puro; `true` no passo do
# runbook §11, junto com a volta ao domínio. A chave AUSENTE não é equivalente
# a `false`: `session.php:172` lê `env('SESSION_SECURE_COOKIE')` SEM default,
# então a ausência vira null e, com o TLS de pé, o cookie de sessão do Sanctum
# sai SEM a flag Secure — viajando em claro sem aparecer em diff nenhum. E
# `true` em HTTP puro tem o sintoma oposto e visível: o browser não grava o
# cookie e o login não fecha. Por isso a chave é explícita e tem fase.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# ATENÇÃO — FRONTEND_URL É CONTEÚDO DE DOCUMENTO LEGAL, não só infra.
# O QR do certificado é `FRONTEND_URL + /validar/{uuid}`
# (Domains/Certification/Services/CertificatePdfService.php) e o certificado é
# snapshot IMUTÁVEL depois de emitido. Certificado emitido na fase sem DNS
# carrega o EIP cru no QR PARA SEMPRE, e o EIP é infra descartável: recriada a
# instância, o QR aponta para o nada — ou para outra coisa.
# REGRA: nenhum certificado REAL se emite antes de FRONTEND_URL estar no
# domínio definitivo com https. Na fase sem DNS só se emite certificado de
# prova, e ele se apaga junto com a prova (Q-3 do review de 2026-09-20).
FRONTEND_URL=http://app.lotusotec.cl
SANCTUM_STATEFUL_DOMAINS=app.lotusotec.cl

# S3 REAL com instance role: sem AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY de
# propósito — o SDK cai na chain do IMDSv2 (hop limit 2, runbook §6). Sem
# AWS_ENDPOINT: o endpoint é o da própria AWS.
FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=<lotus-prod-ACCOUNTID>
AWS_USE_PATH_STYLE_ENDPOINT=false

# Bucket dos dumps do backup-db.sh (pode ser o mesmo AWS_BUCKET).
LOTUS_BACKUP_BUCKET=<lotus-prod-ACCOUNTID>

# Canal do verificar-backup.sh (runbook §9), que é a DETECÇÃO do gatilho de
# reversão do ADR-09. É o mesmo tópico do billing alarm (runbook §10), cuja
# subscription já está confirmada. A região sai do próprio ARN — o tópico vive
# em us-east-1 e a EC2 em sa-east-1. Sem esta chave o script RECUSA rodar, em
# vez de degradar para o silêncio que ele veio consertar.
LOTUS_ALERT_TOPIC_ARN=<arn:aws:sns:us-east-1:ACCOUNTID:lotus-alertas>

# E-mail fica em log até o bloco de SES (spec §3).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=lotus@lotusotec.cl
MAIL_FROM_NAME=Lotus

# Emissor dos certificados. `config/app.php` tem default embutido
# ('OTEC LOTUS SpA' / '77.510.327-2'), então a ausência aqui NÃO quebra a
# emissão — ela grava o default no snapshot do certificado, que é documento de
# peso legal e imutável depois de emitido. Explícito no host, e conferido com a
# Lotus antes da primeira emissão real.
CERTIFICATE_ISSUER_NAME=OTEC LOTUS SpA
CERTIFICATE_ISSUER_RUT=77.510.327-2
