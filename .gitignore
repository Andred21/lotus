# dependências (cada ambiente instala o seu)
/backend/vendor
/frontend/node_modules
/frontend/dist
/frontend/.pnpm-store

# Ambiente / segredos
# `.env*` e não `.env`: o Vite lê também `.env.local`, `.env.development` e
# `.env.development.local` — que o Compose NÃO lê —, então um offset esquecido
# numa dessas variantes muda a porta do dev server sozinho e ainda entraria num
# `git add -A` (achado Q-4 do review de 2026-08-24). O padrão cobre de quebra o
# backup que a catraca de `compose-dev.test.ts` cria. Os moldes versionados são
# a exceção.
/.env*
!/.env.example
/backend/.env*
!/backend/.env.example
/frontend/.env*
!/frontend/.env.example

# Chaves e storage gerado
/backend/storage/*.key

# Docker / sistema
.DS_Store

# Claude Code / Superpowers — estado local, não versionado
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.superpowers/sdd/progress.md
.superpowers/brainstorm/

# Revisão UI/UX assistida — evidências locais, sessões e credenciais efêmeras
.playwright-cli/
.artifacts/ui-review/
